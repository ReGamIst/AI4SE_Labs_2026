---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	load_corpus(load_corpus)
	extract(extract)
	normalize(normalize)
	organize(organize)
	consolidate(consolidate)
	integrate(integrate)
	check(check)
	review(review)
	revise(revise)
	apply_revision(apply_revision)
	render(render)
	__end__([<p>__end__</p>]):::last
	__start__ --> load_corpus;
	apply_revision --> check;
	check --> review;
	consolidate --> integrate;
	extract --> normalize;
	integrate --> check;
	load_corpus -.-> extract;
	normalize --> organize;
	organize -.-> consolidate;
	review -.-> render;
	review -.-> revise;
	revise --> apply_revision;
	render --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
